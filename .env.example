# Copy to .env for docker compose. Never commit a populated .env.
# Everything is disabled by default; set values only when you have your own credentials.

HUB_ROOT=/opt/lighthouse-hub
HUB_CONFIG=/opt/lighthouse-hub/config/hub.toml
DRY_RUN=true

# X (Twitter) API v2 - optional, paid tier required by X.
X_BEARER_TOKEN=

# YouTube Data API v3 key from your own Google Cloud project.
YOUTUBE_API_KEY=

# Optional youtube-acquisition profile: use a qualified immutable image.
# This service does not load API keys from .env; the file contains the key only.
# LIGHTHOUSE_ACQUISITION_IMAGE=your-qualified-image@sha256:your-verified-digest
YOUTUBE_API_KEY_SECRET_FILE=./secrets/youtube-api-key

# OpenAI-compatible model endpoint used for translation/QA.
MODEL_API_STYLE=openai_responses
MODEL_BASE_URL=https://api.example.com/v1
MODEL_ALLOWED_HOSTS=api.example.com
MODEL_API_KEY=
MODEL_NAME=your-model
QA_MODEL_NAME=your-qa-model
MODEL_MAX_OUTPUT_TOKENS=1800
BUDGET_MODEL_UNLIMITED=false

# Tencent Cloud COS (CloudBase) backup - your own bucket and sub-account.
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=
CLOUDBASE_BUCKET=
CLOUDBASE_REGION=ap-shanghai
