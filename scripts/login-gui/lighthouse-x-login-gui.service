[Unit]
Description=Temporary owner X login GUI (loopback SSH only)
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/lighthouse-hub/scripts/login-gui/session.py host
ExecStopPost=/usr/bin/python3 /opt/lighthouse-hub/scripts/login-gui/session.py cleanup
RuntimeMaxSec=1280
TimeoutStopSec=60
Restart=no
KillMode=mixed
UMask=0077
StandardOutput=journal
StandardError=journal
